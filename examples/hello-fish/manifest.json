    "Tool",
    "Integration"
  ],
  "configSchema": {
    "type": "object",
    "properties": {}
  },
  "tools": [
    {
      "name": "greet",
      "description": "向主人问好",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
